{
  "name": "react-typeflux",
  "version": "0.1.2",
  "description": "A lightweight, modern, and customizable rich text editor and viewer for React.",
  "type": "module",
  "main": "./dist/react-typeflux.umd.js",
  "module": "./dist/react-typeflux.es.js",
  "exports": {
    ".": {
      "import": "./dist/react-typeflux.es.js",
      "require": "./dist/react-typeflux.umd.js"
    },
    "./dist/react-typeflux.css": "./dist/react-typeflux.css"
  },
  "files": [
    "dist/*.js",
    "dist/*.css",
    "README.md"
  ],
  "keywords": [
    "react",
    "editor",
    "rich-text",
    "wysiwyg",
    "viewer",
    "text-editor",
    "react-component",
    "react-editor"
  ],
  "author": "codebase_11",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/haryomidey/react-typeflux.git"
  },
  "scripts": {
    "build": "node api.js && vite build",
    "dev": "node api.js && vite",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  }
}
